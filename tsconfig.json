{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "esnext"
    ],
    "allowJs": true,
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "CommonJS",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "jsx": "react",
    "jsxFactory": "createElement",
    "jsxFragmentFactory": "Fragment",
    "paths": {
      "scripting": [
        "./dts/scripting.d.ts"
      ]
    },
    "types": []
  },
  "include": [
    "./dts/*.d.ts",
    "WLOC 虚拟定位",
    "设备工具箱",
    "JavBus",
    "快捷指令签名"
  ],
  "exclude": [
    "./dts/scripting.d.ts"
  ]
}
